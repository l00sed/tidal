-- Carnage · E minor · 88 BPM
-- Em9 · Cmaj7 · Am9 · B7#9. Trump's 2017 inaugural chopped ("American– American– carnage", "America first"),
-- clean jazz guitar, trumpet hook, Jupiter-8 bass.
-- Lo-fi → hi-fi flip: bars 1–4 are dusty (crushed boom-bap, VHS wobble); bars 5–8 snap to a clean
-- DrumTraks kit and a dry, full-range band.

setcps (88/60/4)

let cnChords = "<[e3,b3,d4,fs4,g4] [c4,e4,g4,b4] [a3,e4,g4,b4,c5] [b3,ds4,a4,d5]>" :: Pattern Note
    lofi = (\p -> stack [mask "<1!4 0!4>" (vhs 70 $ p # crush 10 # lpf 3000), mask "<0!4 1!4>" (tapeFX 15 p)])

-- Master controls (global): `knobs` turns them on; then setF "vol" / setF "filt" / rampF live; `noKnobs` off.
knobs

-- Jazz guitar: clean electric, Freddie Green-style short comps with a push on the "and" of 2
d1 $ lofi $ human
   $ struct "t ~ ~ t ~ ~ t ~"
   $ eguitar cnChords
   # legato 0.5 # gain 0.85 # pan 0.4
   # room 0.2 # size 0.5
   # orbit 0

-- Trumpet hook, bars 5–8 (hi-fi half)
d2 $ lofi $ human
   $ mask "<0!4 1!4>"
   $ trumpet "<[b5 ~ g5 ~] [e6 ~ d6 b5] [c6 ~ a5 ~] [b5 ~ ~ ~]>"
   # legato 1.2 # gain 0.85 # pan 0.6
   # room 0.3 # size 0.7
   # orbit 5

-- Trump: "this American carnage" / "American– American– carnage" / "stops right here" / "and stops right now",
-- then "America– America– America first" and a pitched-down villain "America first" on bar 8
d3 $ tapeFX 30 $ stack [
     onBar 0 $ clip "voxpol:0" 0 0.32,
     onBar 1 $ struct "t t ~ ~" $ clip "voxpol:0" 0.06 0.21 # cut 1,
     (0.5 ~>) $ onBar 1 $ clip "voxpol:0" 0.06 0.32,
     onBar 2 $ clip "voxpol:0" 0.32 0.60,
     (0.25 ~>) $ onBar 3 $ clip "voxpol:0" 0.60 1,
     onBar 5 $ struct "t t t ~" $ clip "voxpol:1" 0.33 0.45 # cut 1,
     (0.75 ~>) $ onBar 5 $ clip "voxpol:1" 0.33 0.70,
     onBar 7 $ clip "voxpol:1" 0.33 0.70 # psrate 0.75
   ]
   # gain 1.05 # hpf 150 # lpf 6500 # room 0.15 # size 0.4
   # orbit 6

-- Bass: Jupiter-8 "Compacti" (C2 −1c)
d4 $ lofi $ human
   $ struct "t ~ ~ t ~ ~ t ~ ~ ~ t ~ ~ ~ ~ ~"
   $ tuned 35.99 "<e2 c3 a2 b2>"
   # s "jupiter-8-bass:4"
   # legato 0.8 # gain 0.95 # lpf 700
   # orbit 3

-- Drums: dusty boom-bap (bars 1–4) → clean DrumTraks (bars 5–8)
d5 $ human $ stack [
     mask "<1!4 0!4>" $ stack [
       s "[jazz:0, 808bd:4] ~ ~ ~ ~ ~ ~ [jazz:0, 808bd:4] ~ ~ [jazz:0, 808bd:4] ~ ~ ~ ~ ~" # gain 1.05,
       (0.012 ~>) $ s "~ ~ ~ ~ [sn:3, realclaps:1] ~ ~ ~ ~ ~ ~ ~ [sn:3, realclaps:1] ~ ~ ~" # gain 0.95,
       swingBy (1/24) 4 $ s "hh27:0*8" # gain "0.85 0.65"
     ] # crush 8 # shape 0.3 # lpf 4000 # tapeflutter 6,
     mask "<0!4 1!4>" $ stack [
       s "drumtraks:6 ~ ~ ~ ~ ~ ~ drumtraks:6 ~ ~ drumtraks:6 ~ ~ ~ ~ ~" # gain 1.05,
       (0.008 ~>) $ s "~ ~ ~ ~ drumtraks:9 ~ ~ ~ ~ ~ ~ ~ drumtraks:9 ~ ~ [~ drumtraks:8]" # gain 0.95,
       swingBy (1/48) 8 $ s "drumtraks:4*16" # gain "0.85 0.65 0.75 0.65",
       s "~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ drumtraks:5 ~" # gain 0.75
     ]
   ]
   # orbit 2

d6 $ mask "<1!4 0!4>" $ s "vinyl:0" # legato 1 # gain 0.85 # hpf 1500 # orbit 4

hush
