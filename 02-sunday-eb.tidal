-- Sunday Morning · Eb major · 85 BPM
-- Ebmaj9 · Cm9 · Fm9 · Bb13 (I–vi–ii–V). Harp arpeggios, Rhodes, dreamy vocal pad (which sits on Eb/G/Ab).

setcps (85/60/4)

let sunChords = "<[ds4,g4,as4,d5,f5] [c4,ds4,g4,as4,d5] [f4,gs4,c5,ds5,g5] [as3,d4,gs4,c5,g5]>" :: Pattern Note

-- Master controls (global): `knobs` turns them on; then setF "vol" / setF "filt" / rampF live; `noKnobs` off.
knobs

setF "vol" 1
setF "vol" 0.85
setF "filt" 0.05 -- lowpass (dark)
setF "filt" 0.5 -- off
setF "filt" 0.95 -- highpass (thin)

-- Slides: rampF name from to bars (straight line starting now, then holds)
rampF "filt" 0.5 0.1 4 -- darken over 4 bars
rampF "filt" 0.1 0.5 1 -- open back up
rampF "filt" 0.5 0.9 2 -- thin out
rampF "filt" 0.9 0.5 1
rampF "vol" 1 0 16 -- 16-bar fade-out

noKnobs

-- Rhodes: off-beat stabs, short and bouncy
d1 $ tape $ human
   $ struct "~ t ~ ~ ~ t ~ t"
   $ note sunChords
   # s "emu-vintage-piano:1"
   # legato 0.8 # gain 0.75
   # room 0.25 # size 0.6
   # orbit 0

-- Harp: up/down arpeggio an octave above, alternating direction each bar
d2 $ tape $ human
   $ arp "<up down updown downup>"
   $ segment 8
   $ harp (sunChords + 12)
   # legato 2 # gain "0.7 0.5 0.6 0.5"
   # pan (slow 4 $ range 0.3 0.7 sine)
   # room 0.4 # size 0.8
   # orbit 1

-- Vocal pad: one long breath every 4 bars
d3 $ tape
   $ s "<voxpad:0 ~ ~ ~>"
   # legato 4
   # gain 0.55
   # room 0.5 # size 0.9
   # orbit 6

-- Bass: walking-ish roots + 5ths
d4 $ human
   $ note ("<ds3 c3 f3 as2>" + "0 ~ 7 ~ ~ 0 ~ <5 3 2 -1>")
   # s "supersquare" # lpf 350 # legato 0.8 # gain 0.85
   # orbit 3

-- Drums: brighter, mid-tempo bounce with a clap layer
d5 $ human $ stack [
     s "[jazz:0, 808bd:4] ~ ~ jazz:0 ~ ~ ~ ~ ~ ~ [jazz:0, 808bd:4] ~ ~ ~ ~ ~" # gain 1 # shape 0.3,
     (0.008 ~>) $ s "~ ~ ~ ~ [jazz:7, realclaps:1] ~ ~ ~ ~ ~ ~ ~ [jazz:7, realclaps:1] ~ ~ ~" # gain 0.9,
     swingBy (1/48) 8 $ s "hh27:0*16" # gain "0.7 0.45 0.55 0.45" # hpf 6000
   ]
   # orbit 2

d6 $ s "vinyl:2" # legato 1 # gain 0.9 # hpf 1200 # orbit 4

hush
