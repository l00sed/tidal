-- Rainy Window · D minor · 72 BPM
-- Dm9 · Bbmaj7 · Gm9 · A7b9 (i–VI–iv–V). Real piano, cello bass, flute melody in bars 5–8.

setcps (72/60/4)

-- Global helpers (tape, human, piano, cello, flute, slur, knobs, rampF, …) load at boot from
-- ~/.dotfiles/tidal/LofiHelpers.ghci, so this file only defines its own chords.
let rainChords = "<[d4,f4,a4,c5,e5] [as3,d4,f4,a4] [g3,as3,d4,f4,a4] [a3,cs4,g4,as4]>" :: Pattern Note

-- Master controls (no need to resend patterns). `knobs` turns them on, `noKnobs` off.
-- vol scales every part's gain (gain is ^4: 0.9 ≈ −4 dB, 0.7 ≈ −12 dB) · filt = DJ filter.
knobs

setF "vol" 1
setF "vol" 0.85
setF "filt" 0.05 -- lowpass (dark)
setF "filt" 0.5 -- off
setF "filt" 0.95 -- highpass (thin)

-- Slides: rampF name from to bars (straight line starting now, then holds)
rampF "filt" 0.5 0.1 4 -- darken over 4 bars
rampF "filt" 0.1 0.5 1 -- open back up
rampF "filt" 0.5 0.9 2 -- thin out
rampF "filt" 0.9 0.5 1
rampF "vol" 0.85 0 4 -- fade-out (4 bars)

noKnobs

-- Piano: slow rolled chords on 1, a soft re-voice on the "and" of 3
d1 $ tape $ human
   $ rolledBy "<0.1 0.08>"
   $ struct "t ~ ~ ~ ~ t ~ ~"
   $ piano rainChords
   # legato 2.5 # gain "0.8 0.6"
   # lpf 3500
   # room 0.35 # size 0.85
   # orbit 0

-- Cello: long bowed roots, swelling in
d2 $ tape
   $ cello "<d4 as3 g3 a3>"
   # attack 0.3 # legato 1.1
   # gain 0.75 # lpf 2000
   # room 0.3 # size 0.8
   # orbit 1

-- Flute: D minor melody, bars 5–8, leaning on the A7's C# to pull back home
d3 $ tape $ human $ mask "<0!4 1!4>"
   $ slur
   $ flute "<~ ~ ~ ~ [~ a5 [c6 d6] f6] [e6 ~ d6 ~] [~ as5 a5 g5] [a5 ~ [g5 f5] [e5 d6]]>"
   # legato 1.3
   # gain 0.75
   # delay 0.25 # delayt (3/8) # delayfb 0.35 # lock 1
   # room 0.4 # size 0.85
   # pan 0.6
   # orbit 5

-- Drums: lazy boom-bap, rimshot backbeat, ghosted hats
d4 $ human $ stack [
     s "jazz:0 ~ ~ ~ ~ ~ ~ ~ ~ ~ jazz:0 ~ ~ ~ ~ ~" # gain 1.05 # shape 0.25,
     (0.01 ~>) $ s "~ ~ ~ ~ rs:0 ~ ~ ~ ~ ~ ~ ~ rs:0 ~ ~ ~" # gain 0.9,
     swingBy (1/48) 8 $ degradeBy 0.25 $ s "jazz:3*16" # gain "0.65 0.4" # hpf 7000
   ]
   # lpf 3000
   # orbit 2

d5 $ s "vinyl:0" # legato 1 # gain 0.9 # hpf 1500 # orbit 4

hush
