-- Sunday Service · Bb minor · 72 BPM
-- Bbm9 · Gbmaj7 · Ebm9 · F7#9. Church choir (Bb minor), Roland JV-2080 pad, Oberheim strings lead,
-- DX200 bass. Cassette idea: bar 8 "rewinds" — a backwards, sped-up choir smear with the drums cut.

setcps (72/60/4)

let svcChords = "<[as3,cs4,f4,gs4,c5] [fs3,as3,cs4,f4] [ds4,fs4,as4,cs5,f5] [f3,a3,ds4,gs4]>" :: Pattern Note

-- Master controls (global): `knobs` turns them on; then setF "vol" / setF "filt" / rampF live; `noKnobs` off.
knobs

-- Pad: Roland JV-2080 "KraakvisPad 3" (C3 +1c)
d1 $ tapeFX 45
   $ tuned 48.01 svcChords
   # s "roland-jv2080-pad:29"
   # legato 1.05 # attack 0.3
   # gain 0.8
   # room 0.4 # size 0.9
   # orbit 0

-- Church choir: first ~8 bars of the recording, restarted every 8 bars
d2 $ tapeFX 60
   $ s "<voxchoir:8 ~!7>"
   # end 0.5 # legato 7.5
   # gain 0.5 # hpf 150
   # room 0.35 # size 0.85
   # orbit 6

-- Rewind: second half of bar 8, choir played backwards at double speed
d3 $ mask "<0!7 1>"
   $ s "~ ~ voxchoir:8 ~"
   # begin 0.3 # end 0.36 # speed (-2)
   # legato 2 # gain 0.75 # lpf 2500 # crush 8
   # orbit 7

-- Strings lead: Oberheim "ecstacystring EenNoot" (C5 +2c), bars 5–8
d4 $ tapeFX 45 $ human
   $ tuned 72.02 "<~ ~ ~ ~ [f5 ~ cs5 ~] [ds5 ~ ~ cs5] [as4 ~ c5 cs5] [c5 ~ a4 ~]>"
   # s "oberheim-matrix-1000-strings:3"
   # legato 1.4 # attack 0.05 # gain 0.8 # pan 0.6
   # room 0.4 # size 0.85
   # orbit 5

-- Bass: Yamaha DX200 "FilteredWaveC" (C2 +1c)
d5 $ human
   $ struct "t ~ ~ ~ ~ ~ t ~ ~ ~ t ~ ~ ~ t ~"
   $ tuned 36.01 "<as2 fs2 ds3 f2>"
   # s "yamaha-dx200-bass:0"
   # tapewow 10 # legato 0.85 # gain 0.95 # lpf 600
   # orbit 3

-- Drums drop out for the rewind
d6 $ human
   $ whenmod 8 7 (within (0.5, 1) (const silence))
   $ stack [
       s "[jazz:0, 808bd:4] ~ ~ ~ ~ ~ ~ [jazz:0, 808bd:4] ~ ~ [jazz:0, 808bd:4] ~ ~ ~ ~ ~" # gain 1.05 # shape 0.3,
       (0.008 ~>) $ s "~ ~ ~ ~ [jazz:7, realclaps:1] ~ ~ ~ ~ ~ ~ ~ [jazz:7, realclaps:1] ~ ~ ~" # gain 0.95,
       swingBy (1/48) 8 $ degradeBy 0.15 $ s "hh27:0*16" # gain "0.85 0.7 0.78 0.7" # hpf 6000
     ]
   # tapeflutter 4
   # orbit 2

d7 $ s "vinyl:2" # legato 1 # gain 0.8 # hpf 1500 # orbit 4

hush
