setcps(0.5)
hush

d8
  $ sound "ab:5*[1] ab:5*[0|1] - -"
d1
  $ sound "ab:5*[1] ab:5*[0|1] - -"
d1
  $ s "ab:5*[1] [ab:4*[0|1] ab:5*[0|1|2]] - -"
  # lpf (range 200 100 $ slow 4 sine)
  # release 0.85
  # gain 2

d7
  $ sound "- - ab:12*[1|2] -"
d2
  $ sound "- - ab:12*[1|2] -"
d2
  $ s "- - ab:12*[1|2] -"
  # lpf (range 400 2000 $ slow 4 sine)
  # gain 2

d6
  $ slow 2
  $ s "ab:9*[1|2] ab:2*[1] [ab:7*[0|3]] [ab:8 ab:9]"
  # legato 5
  # room 3
  # lpf (range 800 2000 $ slow 4 sine)
  # gain 0.6

d1 silence
d2 silence
d4 silence

d4
  $ s "ab:10*[0|1|3] ab:12 - kurt:4"
  # lpf (range 400 1000 $ slow 4 sine)
  # freq (range 400 1000 $ slow 4 sine)

d9
  $ slow 2
  $ s "bass2:1*[1|2] - - -"
  # distort 0.125
  # release 2
  # room 1.4
  # lpf (range 200 400 $ fast 4 sine)
  # freq (range 400 200 $ fast 4 sine)
  # gain 0.75

d5
  $ slow 2
  $ s "bass2:1*[1|2] - - -"
  # distort 0.125
  # release 2
  # room 1.4
  # lpf (range 200 400 $ fast 4 sine)
  # freq (range 400 200 $ fast 4 sine)
  # gain 0.75
  # gain 1

d9 silence
d5 silence
d6 silence

d9
  $ slow 2
  $ s "can:1*[1|4] - - can:4"
  # freq (range 440 600 $ fast 4 sine)
  # gain 0.5

d10
  $ slow 2
  $ s "kurt:7*[0|3] kurt:2*[0|1] kurt:1*[0|1] -"
  # lpf (range 100 600 $ slow 1 sine)
  # room 2.5
  # gain 0.6

d10 silence

d5
  $ fast 1
  $ s "ab:5*2 -"
  # room 4
  # distort 0.01
  # gain 2

d6
  $ fast 1
  $ s "- ab:8"
  # gain 2

d14
  $ slow 4
  $ note "b6'maj _ _ [b6'maj c7'maj] _ _ b6'maj _ _ [f7'maj c7'maj] _ _"
  # legato 3
  # distort 1
  # octave 0
  # room 2
  # s "superhammond"
  # gain 0.4

d14 silence

d7
  $ slow 3
  $ n "[ef] [e]"
  # s "superhammond"
  # room 1.5
  # legato 1
  # octave 3
  # lpf (range 100 800 $ fast 8 sine)
  -- # speed (range 0.5 1.5 $ fast 3.5 sine)
  # gain 0.75

d2 silence

d5
  $ slow 2
  $ sound "bd:1*[1|2] - - sn:4*[1|6]"
  # gain 1

d8
  $ slow 2
  $ sound "hh [hh:5*[0|2] hh:5*[0|1]] - -"

d1
  $ sound "sax"
  # legato 1
  # squizbus 1 "1 2 5 1.5"
  # lpfbus 2 "400 2000 3000"
  # lpq 0.2

d1
  $ note "f3'maj"
  # s "trump:5"
  # distort 0.1
  # legato 10
  # speed 0.25
  # room 10
  # gain 1

d3 $ silence

d3
  $ slow 4
  $ note "[f6*2 f5*2] [f4 f4] [f4*2 -] - - [a6*3 -] [a6*3 -] - [b6 b6]"
  # s "bd:6"
  # hpf 500
  # speed 1
  # gain 1.25

d1
  $ slow 4
  $ note "d8*8 ds8*8"
  # s "superpiano"
  # lpf 400
  # gain 1

d2
  $ slow 4
  $ note "d4'maj c4'min"
  # s "superhammond"
  # room 20
  # attack 0.5
  # hold 2
  # release 0.5
  # legato 10
  # speed (range 14 0.125 $ fast 1 sine)
  # lpf (range 0 800 $ fast 1 sine)
  # gain (range 1 5 $ fast 1 sine)

d12
  $ slow 2
  $ note "b2'maj f2'maj"
  # s "trump:6"
  # octave 3
  # attack 0.2
  # sustain 4
  # decay 4
  # distort 5
  # attack 0.9
  # room 10
  # lpf (range 150 500 $ fast 8 sine)
  # legato 2
  # gain 0.25
  # lpf (range 150 500 $ slow 8 sine)
  # legato 1
  # gain 0.9
  # lpf (range 150 500 $ slow 8 sine)
  # legato 2
  # gain 0.8

d12 silence

d13
  $ slow 2
  $ note "- e4*[1]@8 f4*[1]@4 e4*[1]@4 aff4*[1]@4 cf4*[1]@16 c4*[1]@16 cf5*[1|2]@4 c5*[1|2]@4 - - - - - -"
  # s "sax:4"
  # room 2.5
  # lpf (range 400 800 $ fast 8 sine)
  -- # freq (range 120 520 $ slow (range 1 9 $ sine) sine)
  # legato 1.25
  # gain 0.85

d11
  $ slow 2
  $ n "b6'minor _ _ a6'minor _ _"
  # s "superhammond"
  # lpf (range 0 1000 $ fast 2 sine)
  -- # speed (range 0.25 2.5 $ fast 23.5 sine)
  # fshift (range 0 10 $ fast 4 sine)
  # gain 0.75

d11 silence
d13 silence

d8
  $ slow 2
  -- $ stut 8 1 (1/8)
  $ n "[b5'minor*[1|3]] [b6'minor*[1|3]] [c6'minor*3] [c7'minor*3]"
  # s "superpiano"
  # fshift (range 0 10 $ fast 4 sine)
  # room 10
  # legato 5
  # lpf (range 100 300 $ slow 1 sine)
  # gain 0.65

d8 silence

d12
  $ slow 1
  $ stut 2 1 (1/16)
  $ palindrome
  $ n "[c7 b7] [b7 af7] [af7 g7] [g7 f7] [d7 c6] [b6 af6]"
  # s "superpiano"
  # fshift (range 0 10 $ fast 4 sine)
  # room 10
  # legato 5
  # lpf (range 100 300 $ slow 1 sine)
  # gain 0.75

d12 silence

d12 silence
d9 silence

d9
  $ slow 4
  $ n "[c'maj _ _]*4 [g'maj _ _]*4"
  # s "superpiano"
  # octave 3
  # room 10
  # distort 0.1
  # legato 5
  # lpf (range 800 1000 $ fast 2 sine)
  # gain 0.5

d10 silence

d10
  $ s "vinyl"
  # gain 1.25
