  # slide 5.5
d1 $ "reverbkick:1 - - - reverbkick:5*2 - - -"
d4 $ "rave:4 rave:6 rave:3"
d6 $ "kurt:3 - - kurt:2"
d5 $ "odx:1"
hush
d2 $ "sitar:1 - - - sitar:2 - - - sitar:3 - - -"
d13 $ "monsterb:3"
  # gain 1.5
d14 $ "alphabet:17 alphabet:4 alphabet:18 alphabet:15 alphabet:4 alphabet:2 alphabet:19"
  # lpf (range 800 1200 $ slow 2 sine)
d15 $ "breaks157:2"
d6 $ silence
