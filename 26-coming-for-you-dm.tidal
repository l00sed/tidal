-- Coming For You · D minor · 80 BPM · 80 bars ≈ 4:00
-- Dm9 · Ebmaj7 · Gm6 · A7b9 (the bII Ebmaj7 gives it the dread). Night of the Living Dead (1968) throughout.
-- Ensemble: piano, vibes, clean guitar, upright bass, tenor sax solo, muted trumpet, jazz kit + DrumTraks ride,
-- tabla triplets, congas, a singing bowl.
--
-- Form:  i intro 8 · a groove 15 · x pre-drop 1 · b DROP 16 · d breakdown 8 · s sax solo 15 · x 1 · c sax/trumpet trade 8 · o outro 8
-- Tape:  tape wobble in the groove sections, deep VHS wobble in the breakdown and outro.
-- HOW TO PLAY: send setcps, the form block, then `resetCycles` (starts the form at bar 1),
-- then every d-pattern. Each part only sounds in its sections, so everything can be sent up front and the
-- arrangement plays itself; after the outro it falls silent.

setcps (80/60/4)

let form = "<i!8 a!15 x b!16 d!8 s!15 x c!8 o!8 ~!32>" :: Pattern String
    inS ss p = mask (fmap (`elem` words ss) form) p
    cfChords = "<[d4,f4,a4,c5,e5] [ds4,g4,as4,d5] [g3,as3,d4,e4] [a3,cs4,g4,as4]>" :: Pattern Note
    dark p = stack [inS "d o" (vhs 90 p), inS "i a x b s c" (tapeFX 35 p)]

-- Master controls (global): `knobs` turns them on; then setF "vol" / setF "filt" / rampF live; `noKnobs` off.
knobs

setF "vol" 1
setF "vol" 0.85
setF "filt" 0.05 -- lowpass (dark)
setF "filt" 0.5 -- off
setF "filt" 0.95 -- highpass (thin)

-- Slides: rampF name from to bars (straight line starting now, then holds)
rampF "filt" 0.5 0.1 4 -- darken over 4 bars
rampF "filt" 0.1 0.5 1 -- open back up
rampF "filt" 0.5 0.9 2 -- thin out
rampF "filt" 0.9 0.5 1
rampF "vol" 1 0 16 -- 16-bar fade-out

noKnobs

resetCycles

-- Piano: sparse, rolled, the only harmony in the intro and outro
d1 $ dark $ human $ inS "i a b d s c o"
   $ rolledBy 0.07
   $ struct "t ~ ~ ~ ~ ~ <~ t> ~"
   $ piano cfChords
   # legato 2 # gain 0.8
   # room 0.4 # size 0.85
   # orbit 0

-- Vibes: rippling arpeggios an octave up
d2 $ dark $ human $ inS "a b s c"
   $ arp "<up down>"
   $ segment 8
   $ vibes (cfChords + 12)
   # legato 1.2 # gain 0.7 # pan (slow 4 $ range 0.3 0.7 sine)
   # room 0.35 # size 0.8
   # orbit 1

-- Clean guitar: off-beat comps
d3 $ dark $ human $ inS "a b s"
   $ struct "~ t ~ [~ t]"
   $ eguitar cfChords
   # legato 0.3 # gain 0.75 # pan 0.35
   # orbit 0

-- Sax: 8-bar solo in s, odd bars of the trade in c
d4 $ dark $ human $ stack [
     inS "s" $ jsax "<[a4 ~ d5 f5] [g5 ~ ds5 d5] [as4 [d5 e5] g5 ~] [cs5 ~ as4 a4] [~ d5 f5 a5] [as5 ~ g5 ds5] [e5 ~ [d5 as4] g4] [a4 cs5 e5 g5]>",
     inS "c" $ jsax "<[a4 ~ d5 f5] ~ [as4 [d5 e5] g5 ~] ~ [~ d5 f5 a5] ~ [e5 ~ [d5 as4] g4] ~>"
   ]
   # legato 1.3
   -- # attack 0.02
   # gain 0.9 # pan 0.6
   # room 0.3 # size 0.75
   # orbit 5

-- Muted trumpet: long tones over the drop, even bars of the trade
d5 $ dark $ human $ stack [
     inS "b" $ trumpet "<d6 g6 e6 cs6>" # legato 0.95,
     inS "c" $ trumpet "<~ [as5 ~ g5 ds5] ~ [cs6 ~ as5 ~] ~ [g5 as5 d6 ~] ~ [e6 ~ cs6 a5]>" # legato 1.1
   ]
   # gain 0.85 # lpf 2200 # pan 0.4
   # room 0.3 # size 0.7
   # orbit 5

-- Upright bass: walking chord tones; long roots in the breakdown
d6 $ dark $ human $ stack [
     inS "a b s c" $ ubass "<[d3 f3 a3 c4] [ds3 g3 as3 d4] [g2 as2 d3 e3] [a2 cs3 e3 g3]>" # legato 0.9,
     inS "d" $ ubass "<d3 ds3 g2 a2>" # legato 1
   ]
   # gain 1 # lpf 1800
   # orbit 3

-- Kit: swing groove (a), heavier with an 808 layer + crush on the drop (b), clean and airy for the solos (s, c)
d7 $ human $ stack [
     inS "a b s c" $ swingBy (1/6) 4 $ s "drumtraks:7 [~ drumtraks:7] drumtraks:7 [~ drumtraks:7]" # gain 0.75,
     inS "a s c" $ s "jazz:0 ~ ~ ~ ~ ~ ~ jazz:0 ~ ~ jazz:0 ~ ~ ~ ~ ~" # gain 1,
     inS "b" $ s "[jazz:0, 808bd:4] ~ ~ ~ ~ ~ ~ [jazz:0, 808bd:4] ~ [jazz:0, 808bd:4] ~ ~ ~ ~ ~ ~" # gain 1.1 # crush 9 # shape 0.35,
     inS "a b s c" $ (0.012 ~>) $ s "~ ~ ~ ~ [jazz:7, rs:0] ~ ~ ~ ~ ~ ~ ~ [jazz:7, rs:0] ~ ~ ~" # gain 0.95,
     inS "a b" $ degradeBy 0.4 $ s "~ ~ jazz:7 ~ ~ ~ ~ ~ ~ jazz:7 ~ ~ ~ ~ ~ jazz:7" # gain 0.65 # lpf 2500,
     inS "b" $ swingBy (1/24) 8 $ s "hh27:0*16" # gain "0.8 0.55 0.7 0.55" # hpf 6000
   ]
   # tapeflutter 4
   # orbit 2

-- Percussion: tabla triplets against the 4/4 (drop + trade), congas, a singing bowl in the quiet sections
d8 $ human $ stack [
     inS "b c" $ fast 2 $ s "tabla:9 tabla:19 [tabla:0 ~]" # gain 0.85 # pan 0.7,
     inS "a b s c" $ s "~ drumnibus-percussion:18 ~ [~ drumnibus-percussion:19]" # gain 0.8 # pan 0.3,
     inS "i d o" $ s "<drumnibus-percussion:2 ~ ~ ~>" # legato 4 # gain 0.85 # room 0.5 # size 0.9
   ]
   # orbit 7

-- Night of the Living Dead
d9 $ stack [
     inS "i" $ stack [
       onBar 2 $ clip "voxfilm:15" 0 1, onBar 5 $ clip "voxfilm:16" 0 1, onBar 7 $ clip "voxfilm:14" 0 1
     ],
     inS "a" $ stack [
       onBar 0 $ clip "voxfilm:8" 0 1,
       onBar 4 $ struct "t t ~ ~" $ clip "voxfilm:8" 0 0.4 # cut 1,
       (0.5 ~>) $ onBar 4 $ clip "voxfilm:9" 0.3 1
     ],
     inS "x" $ clip "voxfilm:10" 0 1 # gain 1.1,
     inS "b" $ stack [
       onBar 0 $ clip "voxfilm:11" 0 0.5,
       onBar 3 $ clip "voxfilm:13" 0 1 # psrate 0.8,
       (0.5 ~>) $ onBar 6 $ clip "voxfilm:12" 0 1 # speed (-1) # lpf 2500
     ],
     inS "d" $ echoWith 3 (3/16) ((|* gain 0.85) . (# lpf 1800)) $ stack [onBar 1 $ clip "voxfilm:12" 0 1, onBar 5 $ clip "voxfilm:17" 0 1],
     inS "s" $ onBar 0 $ clip "voxfilm:9" 0 1 # psrate 0.75,
     inS "c" $ onBar 7 $ slice 4 "0 1 [0 1] ~" $ s "voxfilm:12",
     inS "o" $ stack [onBar 3 $ clip "voxfilm:18" 0 1 # room 0.6 # size 0.95, onBar 7 $ clip "voxfilm:18" 0 1 # room 0.6 # size 0.95]
   ]
   |< gain 1.05 # hpf 150 # lpf 6500 # room 0.15 # size 0.4
   # tapewow 30 # orbit 6

d10 $ inS "i a x b d s c o" $ s "vinyl:0" # legato 1 # gain 0.85 # hpf 1500 # orbit 4

hush
